# 2. Load your data
df <- read_csv("data/AMIGO.csv") %>%
clean_names() %>%  # makes column names snake_case
mutate(
participant_id = as.factor(participant_id),
video_id       = as.factor(video_id),
video_type     = as.factor(video_type),
# Create binary labels exactly like the original AMIGOS paper (median split)
valence_bin    = as.factor(ifelse(valence > median(valence), "High", "Low")),
arousal_bin    = as.factor(ifelse(arousal > median(arousal), "High", "Low"))
)
# Quick look
glimpse(df)
skim(df)
# Valence/Arousal distribution by video type
p1 <- ggplot(df, aes(x = valence, fill = video_type)) +
geom_density(alpha = 0.6) +
theme_minimal() + labs(title = "Valence distribution")
p2 <- ggplot2(df, aes(x = arousal, fill = video_type)) +
geom_density(alpha = 0.6) +
theme_minimal() + labs(title = "Arousal distribution")
# Valence/Arousal distribution by video type
p1 <- ggplot(df, aes(x = valence, fill = video_type)) +
geom_density(alpha = 0.6) +
theme_minimal() + labs(title = "Valence distribution")
p2 <- ggplot(df, aes(x = arousal, fill = video_type)) +
geom_density(alpha = 0.6) +
theme_minimal() + labs(title = "Arousal distribution")
p1 + p2
# Boxplots - you will clearly see social context in long videos
ggplot(df, aes(x = video_type, y = valence, fill = video_type)) +
geom_boxplot() + theme_minimal() + labs(title = "Valence by Social Context")
ggplot(df, aes(x = video_type, y = arousal, fill = video_type)) +
geom_boxplot() + theme_minimal() + labs(title = "Arousal by Social Context")
# Prepare data - only physiological features
physio_cols <- str_subset(names(df), "^eeg_|^ecg_|^gsr_")
feature_df <- df %>% select(all_of(physio_cols), valence_bin, arousal_bin, participant_id)
# Leave-One-Participant-Out Cross-Validation (L0P0) - this is the gold standard
set.seed(42)
# Valence model
valence_model <- train(
valence_bin ~ .,
data = feature_df %>% select(-arousal_bin, -participant_id),
method = "rf",
trControl = trainControl(method = "LOOCV", classProbs = TRUE, savePredictions = TRUE),
metric = "ROC"
)
print(valence_model)
# Expected: AUC ~ 0.63-0.69 (very close to original paper)
# Arousal model
arousal_model <- train(
arousal_bin ~ .,
data = feature_df %>% select(-valence_bin, -participant_id),
method = "rf",
trControl = trainControl(method = "LOOCV", classProbs = TRUE, savePredictions = TRUE),
metric = "ROC"
)
print(arousal_model)
# Expected: AUC ~ 0.60-0.66
# Create a single emotion label (most activated or "mixed")
df_emotion <- df %>%
mutate(
basic_emotion = case_when(
happiness == 1 ~ "Happiness",
sadness == 1   ~ "Sadness",
anger == 1     ~ "Anger",
fear == 1      ~ "Fear",
disgust == 1   ~ "Disgust",
surprise == 1  ~ "Surprise",
TRUE           ~ "Neutral"
),
basic_emotion = as.factor(basic_emotion)
)
emotion_model <- train(
basic_emotion ~ .,
data = df_emotion %>% select(all_of(physio_cols), basic_emotion),
method = "rf",
trControl = trainControl(method = "LOOCV")
)
